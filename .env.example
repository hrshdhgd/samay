# From @BotFather
TELEGRAM_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot. Empty = the bot refuses to start.
ALLOWED_CHAT_IDS=

# Optional local model (Ollama). With OLLAMA_URL set, every answer is followed by a separate message
# labelled "AI says:" with the model's own words, and the model also sorts questions into topics.
# On the Oracle server the host Ollama is reachable at the docker0 gateway:
# OLLAMA_URL=http://172.17.0.1:11434
# OLLAMA_MODEL=llama3.2:3b        # sorts questions (small and fast)
# OLLAMA_QA_MODEL=gemma3:12b      # writes the "AI says:" answer (defaults to OLLAMA_MODEL; slower on CPU)
# OLLAMA_NARRATE=1               # also reword /today with the model (off by default)

# Key that encrypts birth details and the living city in the database. Make one with:
#   uv run samay keygen
# On a server set it here, keep a copy somewhere safe (without it the data cannot be read), and
# never commit it. For local development, if unset, a key file is created in data/ (git-ignored).
SAMAY_DB_KEY=
