# From @BotFather
TELEGRAM_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot. Empty = the bot refuses to start.
ALLOWED_CHAT_IDS=

# Local model (Ollama). Docker Compose defaults to the host Ollama at
# http://host.docker.internal:11434. Set this only to override that URL; leave it empty to disable AI.
# When running Samay directly (outside Docker), use http://localhost:11434.
# OLLAMA_URL=http://localhost:11434
# Shared with StockBro on Oracle: small model for routing, one answer model for longer responses.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_QA_MODEL=qwen2.5:14b
# OLLAMA_NARRATE=1               # also reword /today with the model (off by default)

# Key that encrypts birth details and the living city in the database. Make one with:
#   uv run samay keygen
# On a server set it here, keep a copy somewhere safe (without it the data cannot be read), and
# never commit it. For local development, if unset, a key file is created in data/ (git-ignored).
SAMAY_DB_KEY=
