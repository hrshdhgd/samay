# From @BotFather
TELEGRAM_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot. Empty = the bot refuses to start.
ALLOWED_CHAT_IDS=

# Optional LLM narration. Off unless OLLAMA_URL is set; the template is then the reading.
# On the Oracle server the host Ollama is reachable at the docker0 gateway:
# OLLAMA_URL=http://172.17.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
